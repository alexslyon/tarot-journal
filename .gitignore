*.log

# User config files (personal settings, not code)
app_config.json
theme_config.json

# App summary (for Claude context transfer, not code)
APP_SUMMARY.md

# Deck image folders: scans live on disk (and in your image backups),
# not in git — they're large, never change, and don't belong in
# version control. The app reads them straight from disk.
Hello Tarot/
Blue Owl Lenormand/
PlayingCards/
Rider-Waite-Smith/
TdM/
Thoth/

# Rotated log files (tarot_journal.log.1, .2, ...)
*.log.*
out/
